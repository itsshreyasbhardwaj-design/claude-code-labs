{
  "name": "cc-aperture",
  "version": "0.1.0",
  "description": "See exactly what Claude Code loads into every session's context, and trim the bloat.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aperture": "./dist/cli.js"
  },
  "files": ["dist", "aperture.config.schema.json"],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-bin": "node scripts/check-bin.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check-bin",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "picomatch": "^4.0.2",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@changesets/cli": "^2.27.7",
    "@types/node": "^20.14.15",
    "@types/picomatch": "^3.0.1",
    "@types/react": "^18.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.2.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsshreyasbhardwaj-design/claude-code-labs.git"
  },
  "keywords": ["claude-code", "cli", "developer-tools", "context-window", "tokens"]
}
